// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Listing {
  id          Int      @id @default(autoincrement())
  url         String   @unique
  transaction String // Achat | Location
  access      String // Statut accès
  type        String // Appart | Maison
  price       Int
  city        String
  postalCode  String
  department  String
  surface     Float
  floorRaw    String?
  floor       Int? // 0 = RDC
  floorsTotal Int?
  elevator    Boolean?
  dpe         String?
  seller      String
  publishedAt DateTime? // absente chez Bien'ici
  title       String
  lat         Float?
  lng         Float?
  isNew       Boolean  @default(false) // ajoutée lors du dernier import
  source      String? // leboncoin | Bien'ici | Bien'ici + leboncoin
  zone        String? // Zone principale | Bande +100 km
  zoneDist    Int? // km au-delà de la zone principale
  others      String[] @default([]) // autres annonces identiques (liens)
  duplicateOf Int? // id de l'annonce principale si celle-ci est un doublon (masquée)
  createdAt   DateTime @default(now())
  reviews     Review[]

  @@index([department])
  @@index([duplicateOf])
  @@index([price])
}

model Review {
  id        Int      @id @default(autoincrement())
  listingId Int
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  author    String
  score     Int? // 1..10, null = coup de cœur sans note
  comment   String?
  favorite  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, author])
  @@index([author])
}
