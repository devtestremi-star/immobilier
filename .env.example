# Variables fournies par l'intégration Neon sur Vercel
# (Vercel > projet > Storage > Neon > .env.local, ou Settings > Environment Variables)
# Colle les valeurs entre les guillemets. Ce fichier n'est jamais commité.

# Connexion poolée : utilisée par l'app (Prisma Client)
DATABASE_URL=""

# Connexion directe : utilisée par le CLI Prisma (migrations)
DATABASE_URL_UNPOOLED=""

# Autres variables fournies par Neon (optionnelles pour l'instant)
PGHOST=""
PGHOST_UNPOOLED=""
PGUSER=""
PGDATABASE=""
PGPASSWORD=""
POSTGRES_URL=""
POSTGRES_URL_NON_POOLING=""
POSTGRES_USER=""
POSTGRES_HOST=""
POSTGRES_PASSWORD=""
POSTGRES_DATABASE=""
POSTGRES_URL_NO_SSL=""
POSTGRES_PRISMA_URL=""
NEON_PROJECT_ID=""
